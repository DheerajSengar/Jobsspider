# JobsSpider Environment Configuration Template

# Server & Database Settings
PORT=5000
NODE_ENV=production

# MySQL Database Configuration (Supports Local & Aiven MySQL / Cloud MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=defaultdb
DB_SSL=false
DB_CONNECTION_LIMIT=20

# JWT Authentication Secret
JWT_SECRET=jobspider_super_secret_jwt_key_2026

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URLs for CORS
FRONTEND_URL=http://localhost:3000
REACT_APP_SERVER_URL=https://jobsspider-3.onrender.com
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
